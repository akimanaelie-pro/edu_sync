<?php
header('Content-Type: application/json');
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET, POST, PUT, DELETE');
header('Access-Control-Allow-Headers: Content-Type, Authorization');

require_once __DIR__ . '/../config/config.php';
require_once __DIR__ . '/../config/database.php';

$method = $_SERVER['REQUEST_METHOD'];
$endpoint = $_GET['action'] ?? $_GET['endpoint'] ?? '';

$db = db();

if ($method === 'OPTIONS') {
    exit;
}

function authenticate() {
    $headers = getallheaders();
    $token = $headers['Authorization'] ?? $headers['Authorization'] ?? '';
    
    if (!$token) {
        http_response_code(401);
        echo json_encode(['error' => 'Unauthorized']);
        exit;
    }
    
    $parts = explode(' ', $token);
    if (count($parts) !== 2 || $parts[0] !== 'Bearer') {
        http_response_code(401);
        echo json_encode(['error' => 'Invalid token format']);
        exit;
    }
    
    $userId = (int)$parts[1];
    $user = $db->selectOne("SELECT * FROM users WHERE id = ?", [$userId]);
    
    if (!$user) {
        http_response_code(401);
        echo json_encode(['error' => 'User not found']);
        exit;
    }
    
    return $user;
}

if ($endpoint === 'students') {
    if ($method === 'GET') {
        $students = $db->select("
            SELECT s.*, u.first_name, u.last_name, u.email, u.phone, c.name as class_name
            FROM students s
            JOIN users u ON s.user_id = u.id
            LEFT JOIN classes c ON s.class_id = c.id
            LIMIT 100
        ");
        echo json_encode(['success' => true, 'data' => $students]);
    }
}

if ($endpoint === 'attendance') {
    if ($method === 'GET') {
        $date = $_GET['date'] ?? date('Y-m-d');
        $classId = $_GET['class_id'] ?? '';
        
        $where = "a.date = ?";
        $params = [$date];
        
        if ($classId) {
            $where .= " AND a.class_id = ?";
            $params[] = $classId;
        }
        
        $attendance = $db->select("
            SELECT a.*, u.first_name, u.last_name, s.student_id
            FROM attendance a
            JOIN students s ON a.student_id = s.id
            JOIN users u ON s.user_id = u.id
            WHERE $where
        ", $params);
        
        echo json_encode(['success' => true, 'data' => $attendance]);
    }
    
    if ($method === 'POST') {
        $data = json_decode(file_get_contents('php://input'), true);
        
        $db->insert('attendance', [
            'uuid' => generateUUID(),
            'student_id' => $data['student_id'],
            'class_id' => $data['class_id'],
            'date' => $data['date'],
            'status' => $data['status'],
            'mark_by' => $data['user_id'],
            'mark_method' => $data['method'] ?? 'manual',
            'notes' => $data['notes'] ?? '',
            'sync_status' => 'pending'
        ]);
        
        echo json_encode(['success' => true, 'message' => 'Attendance marked']);
    }
}

if ($endpoint === 'grades') {
    if ($method === 'GET') {
        $studentId = $_GET['student_id'] ?? '';
        $subjectId = $_GET['subject_id'] ?? '';
        
        $where = "1=1";
        $params = [];
        
        if ($studentId) {
            $where .= " AND g.student_id = ?";
            $params[] = $studentId;
        }
        
        if ($subjectId) {
            $where .= " AND g.subject_id = ?";
            $params[] = $subjectId;
        }
        
        $grades = $db->select("
            SELECT g.*, sub.name as subject_name
            FROM grades g
            JOIN subjects sub ON g.subject_id = sub.id
            WHERE $where
            ORDER BY g.created_at DESC
        ", $params);
        
        echo json_encode(['success' => true, 'data' => $grades]);
    }
}

if ($endpoint === 'fees') {
    if ($method === 'GET') {
        $studentId = $_GET['student_id'] ?? '';
        
        $fees = $db->select("
            SELECT fs.*, 
                   (SELECT SUM(amount) FROM fee_payments WHERE student_id = ? AND fee_id = fs.id AND status = 'completed') as paid
            FROM fee_structure fs
            WHERE fs.academic_year = ?
        ", [$studentId ?: 0, getAcademicYear()]);
        
        echo json_encode(['success' => true, 'data' => $fees]);
    }
}

if ($endpoint === 'timetable') {
    if ($method === 'GET') {
        $classId = $_GET['class_id'] ?? '';
        $day = $_GET['day'] ?? '';
        
        $where = "1=1";
        $params = [];
        
        if ($classId) {
            $where .= " AND t.class_id = ?";
            $params[] = $classId;
        }
        
        if ($day) {
            $where .= " AND t.day_of_week = ?";
            $params[] = $day;
        }
        
        $timetable = $db->select("
            SELECT t.*, sub.name as subject_name, u.first_name, u.last_name
            FROM timetable t
            JOIN subjects sub ON t.subject_id = sub.id
            JOIN teachers tea ON t.teacher_id = tea.id
            JOIN users u ON tea.user_id = u.id
            WHERE $where
            ORDER BY t.start_time
        ", $params);
        
        echo json_encode(['success' => true, 'data' => $timetable]);
    }
}

if ($endpoint === 'messages') {
    $user = authenticate();
    
    if ($method === 'GET') {
        $messages = $db->select("
            SELECT m.*, u.first_name, u.last_name as sender_name
            FROM messages m
            JOIN users u ON m.sender_id = u.id
            WHERE m.receiver_id = ?
            ORDER BY m.created_at DESC
            LIMIT 50
        ", [$user['id']]);
        
        echo json_encode(['success' => true, 'data' => $messages]);
    }
    
    if ($method === 'POST') {
        $data = json_decode(file_get_contents('php://input'), true);
        
        $db->insert('messages', [
            'uuid' => generateUUID(),
            'sender_id' => $user['id'],
            'receiver_id' => $data['receiver_id'],
            'subject' => $data['subject'] ?? '',
            'message' => $data['message'],
            'message_type' => 'direct',
            'sync_status' => 'pending'
        ]);
        
        echo json_encode(['success' => true, 'message' => 'Message sent']);
    }
}

if ($endpoint === 'profile') {
    $user = authenticate();
    
    if ($method === 'GET') {
        if ($user['role'] === 'student') {
            $profile = $db->selectOne("
                SELECT s.*, u.first_name, u.last_name, u.email, u.phone, c.name as class_name
                FROM students s
                JOIN users u ON s.user_id = u.id
                LEFT JOIN classes c ON s.class_id = c.id
                WHERE u.id = ?
            ", [$user['id']]);
        } else {
            $profile = $user;
        }
        
        echo json_encode(['success' => true, 'data' => $profile]);
    }
}

if ($endpoint === 'stats') {
    $user = authenticate();
    
    $stats = [
        'total_students' => $db->count('students', '1=1'),
        'total_teachers' => $db->count('teachers', '1=1'),
        'total_classes' => $db->count('classes', '1=1'),
        'today_attendance' => $db->selectOne("
            SELECT (SUM(CASE WHEN status = 'present' THEN 1 ELSE 0 END) / COUNT(*)) * 100 as rate
            FROM attendance WHERE date = CURDATE()
        ")['rate'] ?? 0
    ];
    
    echo json_encode(['success' => true, 'data' => $stats]);
}

// Quick Add Teacher
if ($endpoint === 'quick_add_teacher' && $method === 'POST') {
    $email = $_POST['email'] ?? '';
    $firstName = $_POST['first_name'] ?? '';
    $lastName = $_POST['last_name'] ?? '';
    $phone = $_POST['phone'] ?? '';
    $department = $_POST['department'] ?? '';
    $qualification = $_POST['qualification'] ?? '';
    $password = $_POST['password'] ?? 'teacher123';
    
    if (!$email || !$firstName || !$lastName) {
        echo json_encode(['success' => false, 'message' => 'Email and name are required']);
        exit;
    }
    
    if ($db->exists('users', 'email = ?', [$email])) {
        echo json_encode(['success' => false, 'message' => 'Email already exists']);
        exit;
    }
    
    $userId = $db->insert('users', [
        'uuid' => generateUUID(),
        'email' => $email,
        'password_hash' => password_hash($password, PASSWORD_DEFAULT),
        'role' => 'teacher',
        'first_name' => $firstName,
        'last_name' => $lastName,
        'phone' => $phone,
        'sync_status' => 'pending'
    ]);
    
    $db->insert('teachers', [
        'uuid' => generateUUID(),
        'user_id' => $userId,
        'employee_id' => 'T' . str_pad($db->count('teachers') + 1, 4, '0', STR_PAD_LEFT),
        'department' => $department,
        'qualification' => $qualification,
        'hire_date' => date('Y-m-d'),
        'sync_status' => 'pending'
    ]);
    
    echo json_encode(['success' => true, 'message' => 'Teacher added successfully']);
}

