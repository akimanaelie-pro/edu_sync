// Update Teacher
if ($endpoint === 'update_teacher' && $method === 'POST') {
    $teacherId = (int)($_POST['id'] ?? 0);
    
    if (!$teacherId) {
        echo json_encode(['success' => false, 'message' => 'Invalid teacher ID']);
        exit;
    }
    
    $teacher = $db->selectOne("SELECT user_id FROM teachers WHERE id = ?", [$teacherId]);
    
    if (!$teacher) {
        echo json_encode(['success' => false, 'message' => 'Teacher not found']);
        exit;
    }
    
    $profileImagePath = null;
    
    if (isset($_FILES['profile_image']) && $_FILES['profile_image']['error'] === 0) {
        $uploadDir = __DIR__ . '/../uploads/profiles/';
        if (!is_dir($uploadDir)) {
            mkdir($uploadDir, 0755, true);
        }
        
        $allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
        $fileType = $_FILES['profile_image']['type'];
        
        if (!in_array($fileType, $allowedTypes)) {
            echo json_encode(['success' => false, 'message' => 'Invalid file type. Only JPEG, PNG, GIF, and WebP allowed.']);
            exit;
        }
        
        $extension = pathinfo($_FILES['profile_image']['name'], PATHINFO_EXTENSION);
        $filename = 'teacher_' . $teacher['user_id'] . '_' . time() . '.' . $extension;
        $targetPath = $uploadDir . $filename;
        
        if (move_uploaded_file($_FILES['profile_image']['tmp_name'], $targetPath)) {
            $profileImagePath = 'uploads/profiles/' . $filename;
        }
    }
    
    $userData = [
        'first_name' => $_POST['first_name'] ?? '',
        'last_name' => $_POST['last_name'] ?? '',
        'email' => $_POST['email'] ?? '',
        'phone' => $_POST['phone'] ?? null,
        'sync_status' => 'pending'
    ];
    
    if ($profileImagePath) {
        $userData['profile_image'] = $profileImagePath;
    }
    
    $db->update('users', $userData, 'id = :id', ['id' => $teacher['user_id']]);
    
    $db->update('teachers', [
        'department' => $_POST['department'] ?? '',
        'qualification' => $_POST['qualification'] ?? '',
        'hire_date' => $_POST['hire_date'] ?? null,
        'sync_status' => 'pending'
    ], 'id = :id', ['id' => $teacherId]);
    
    echo json_encode(['success' => true, 'message' => 'Teacher updated successfully']);
}
